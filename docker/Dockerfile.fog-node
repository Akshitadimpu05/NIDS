# Dockerfile for NIDS Fog Node
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies including execstack to fix PyTorch issue
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpcap-dev \
    tcpdump \
    iptables \
    iproute2 \
    net-tools \
    curl \
    execstack \
    && rm -rf /var/lib/apt/lists/*

# Copy minimal requirements and install Python dependencies
COPY docker/requirements-docker.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Fix PyTorch libtorch_cpu.so executable stack issue
RUN find /usr/local/lib/python3.9/site-packages/torch/lib -name "*.so*" -exec execstack -c {} \; 2>/dev/null || true

# Copy source code
COPY src/ ./src/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY data/models/ ./data/models/

# Create necessary directories
RUN mkdir -p data/logs

# Set environment variables
ENV PYTHONPATH=/app:/app/src
ENV PYTHONUNBUFFERED=1

# Create non-root user for security
RUN useradd -m -u 1000 nids && chown -R nids:nids /app
USER nids

# Expose ports (if needed for monitoring)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health')" || exit 1

# Default command
CMD ["python", "scripts/run_fog_node.py"]
